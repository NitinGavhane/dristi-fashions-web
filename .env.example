# Base URL of the Garment E-commerce FastAPI backend.
#
# Leave it at the default to talk to the deployed AWS backend
# (CloudFront -> EC2 -> Postgres), which is what `npm run dev` uses.
#
#   Production (AWS):  https://d100c6f2kgsym4.cloudfront.net
#   Local backend:     http://localhost:8000
#
# Vite inlines this at build time, so changing it needs a dev-server restart.
VITE_API_BASE_URL="https://d100c6f2kgsym4.cloudfront.net"
